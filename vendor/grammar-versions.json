      "version": "0.23.5",
      "scanner": false,
      "default": true,
      "size": "2.5 MB"
    },
    "javascript": {
      "package": "tree-sitter-javascript",
      "version": "0.23.1",
      "scanner": true,
      "default": true,
      "size": "2.8 MB"
    },
    "python": {
      "package": "tree-sitter-python",
      "version": "0.23.6",
      "scanner": true,
      "default": true,
      "size": "3.4 MB"
    },
    "c": {
      "package": "tree-sitter-c",
      "version": "0.23.5",
      "scanner": false,
