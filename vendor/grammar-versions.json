    "typescript": {
      "package": "tree-sitter-typescript",
      "version": "0.23.2",
      "subPath": "typescript",
      "scanner": true,
      "sharedSrc": ["../../common/scanner.h"],
      "inherits": ["javascript"],
      "default": true,
      "size": "17 MB"
    },
    "tsx": {
      "package": "tree-sitter-typescript",
      "version": "0.23.2",
      "subPath": "tsx",
      "scanner": true,
      "sharedSrc": ["../../common/scanner.h"],
