{
  "name": "@enriched-markdown/ios",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone iOS native library for enriched-markdown",
  "scripts": {
    "build": "cd ../.. && swift build",
    "test": "cd ../.. && swift test",
    "test:ios-native": "cd ../.. && xcodebuild test -scheme EnrichedMarkdown -destination \"platform=iOS Simulator,id=${IOS_SIMULATOR_UDID:-booted}\"",
    "clean": "cd ../.. && swift package clean"
  }
}
