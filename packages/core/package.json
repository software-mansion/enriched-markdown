{
  "name": "@enriched-markdown/core",
  "version": "0.0.0",
  "private": true,
  "description": "Shared C++ core (md4c parser, AST) for enriched-markdown native and React Native libraries",
  "files": [
    "cpp",
    "EnrichedMarkdownCore.podspec",
    "package.json"
  ],
  "scripts": {
    "build": "cmake -S cpp/tests -B ../../build/core-tests ${CORE_CMAKE_ARGS:-} && cmake --build ../../build/core-tests",
    "test": "yarn build && ctest --test-dir ../../build/core-tests --output-on-failure",
    "unicode-tables": "node scripts/generate-unicode-tables.mjs"
  }
}
